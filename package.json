{
  "name": "lingterra",
  "version": "0.2.2",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "lint:report": "eslint src tests scripts --format json --output-file .audit/quality/eslint-current.json",
    "lint:check": "node scripts/checkLintBaseline.mjs",
    "coverage": "npm run coverage:domain && npm run coverage:application && node scripts/checkCoverageBaseline.mjs",
    "coverage:domain": "c8 --all --reporter=text --reporter=json-summary --reports-dir=coverage/domain --include=src/domain/**/*.ts ts-node -O \"{\\\"module\\\":\\\"commonjs\\\"}\" tests/testSuite.ts",
    "coverage:application": "c8 --all --reporter=text --reporter=json-summary --reports-dir=coverage/application --include=src/application/**/*.ts ts-node -O \"{\\\"module\\\":\\\"commonjs\\\"}\" tests/applicationRunner.ts",
    "seed:firestore": "ts-node -O \"{\\\"module\\\":\\\"commonjs\\\"}\" scripts/seedFirestore.ts",
    "baseline:manifest": "ts-node -O \"{\\\"module\\\":\\\"commonjs\\\"}\" scripts/generateBaselineManifest.ts",
    "editorial:queue": "ts-node -O \"{\\\"module\\\":\\\"commonjs\\\"}\" scripts/generateEditorialReviewQueue.ts",
    "editorial:report": "ts-node -O \"{\\\"module\\\":\\\"commonjs\\\"}\" scripts/generateEditorialLevelReport.ts",
    "check:a2": "ts-node -O \"{\\\"module\\\":\\\"commonjs\\\"}\" scripts/dump_a2_items.ts",
    "test": "ts-node -O \"{\\\"module\\\":\\\"commonjs\\\"}\" tests/testSuite.ts",
    "test:a11y": "ts-node -O \"{\\\"module\\\":\\\"commonjs\\\"}\" tests/testSuite.ts",
    "test:rules": "firebase emulators:exec --only firestore \"ts-node -O \\\"{\\\\\\\"module\\\\\\\":\\\\\\\"commonjs\\\\\\\"}\\\" tests/firestoreRules.test.ts\"",
    "deploy:firestore": "firebase deploy --only firestore:rules,firestore:indexes",
    "test:e2e:smoke": "maestro test .maestro/smoke.yaml",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "check:architecture": "ts-node -O \"{\\\"module\\\":\\\"commonjs\\\"}\" scripts/checkArchitecture.ts",
    "check:long-function-review": "node scripts/checkLongFunctionReview.mjs",
    "score:quality": "ts-node -O \"{\\\"module\\\":\\\"commonjs\\\"}\" scripts/qualityScore.ts",
    "test:application": "ts-node -O \"{\\\"module\\\":\\\"commonjs\\\"}\" tests/applicationRunner.ts"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/manrope": "^0.4.3",
    "@expo/metro-runtime": "~58.0.16",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^26.3.2",
    "@react-native-firebase/app-check": "^26.3.2",
    "expo": "^58.0.0",
    "expo-asset": "~58.0.19",
    "expo-build-properties": "~58.0.12",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-notifications": "~58.1.7",
    "expo-sharing": "~58.0.21",
    "expo-speech": "~58.0.3",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "firebase": "^12.18.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@expo/ngrok": "^4.1.3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.2.0",
    "@types/react": "~19.3.0",
    "c8": "^12.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.28.1",
    "globals": "^17.13.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
