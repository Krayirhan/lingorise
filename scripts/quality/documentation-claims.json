      "evidencePattern": "npm run test:rules"
    },
    {
      "id": "maestro-gate",
      "document": "docs/CLEAN_ARCHITECTURE_VERIFICATION.md",
      "pattern": "npm run test:e2e:smoke",
      "evidenceFile": "package.json",
      "evidencePattern": "\\\"test:e2e:smoke\\\""
    },
    {
      "id": "quality-score-command",
      "document": "docs/CLEAN_ARCHITECTURE_VERIFICATION.md",
      "pattern": "npm run score:quality",
      "evidenceFile": "package.json",
      "evidencePattern": "\\\"score:quality\\\""
    },
    {
      "id": "long-function-review-gate",
      "document": "docs/CLEAN_ARCHITECTURE_VERIFICATION.md",
      "pattern": "npm run check:long-function-review",
