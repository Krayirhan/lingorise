{
  "expo": {
    "name": "Lingterra",
    "slug": "lingterra",
    "scheme": "lingterra",
    "version": "0.2.2",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/lingorise-app-icon.png",
    "android": {
      "package": "com.lingterra.app",
      "versionCode": 8
    },
    "ios": {
      "bundleIdentifier": "com.lingterra.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "7"
    },
    "plugins": [
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "disableSPM": true
          }
        }
      ],
      "expo-asset",
      "expo-notifications",
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ]
    ],
    "owner": "mfurkant",
    "extra": {
      "eas": {
        "projectId": "7086b907-44a3-4afb-9b8f-91279859dc79"
      }
    }
  }
}
