    },
    {
      "id": "source-files",
      "document": "docs/CLEAN_ARCHITECTURE_VERIFICATION.md",
      "measurement": "sourceFiles",
      "patternTemplate": "{{value}} TS/TSX dosyası"
    },
    {
      "id": "long-functions",
      "document": "docs/CLEAN_ARCHITECTURE_VERIFICATION.md",
      "measurement": "longFunctions",
      "patternTemplate": "{{value}} fonksiyon"
    },
    {
      "id": "full-test-count",
      "document": "docs/CLEAN_ARCHITECTURE_VERIFICATION.md",
      "measurement": "fullTestCount",
      "patternTemplate": "{{value}} geçti, 0 başarısız"
    },
    {
