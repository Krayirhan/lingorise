{
  "version": 1,
  "claims": [
    {
      "id": "typecheck-command",
      "document": "docs/CLEAN_ARCHITECTURE_VERIFICATION.md",
      "pattern": "npm run typecheck",
      "evidenceFile": "package.json",
      "evidencePattern": "\\\"typecheck\\\"\\s*:\\s*\\\"tsc --noEmit\\\""
    },
    {
      "id": "architecture-check-command",
      "document": "docs/CLEAN_ARCHITECTURE_VERIFICATION.md",
      "pattern": "npm run check:architecture",
      "evidenceFile": "package.json",
      "evidencePattern": "\\\"check:architecture\\\""
    },
    {
      "id": "application-test-command",
      "document": "docs/CLEAN_ARCHITECTURE_VERIFICATION.md",
      "pattern": "npm run test:application",
      "evidenceFile": "package.json",
      "evidencePattern": "\\\"test:application\\\""
    },
    {
      "id": "full-test-command",
      "document": "docs/CLEAN_ARCHITECTURE_VERIFICATION.md",
      "pattern": "npm test",
      "evidenceFile": "package.json",
      "evidencePattern": "\\\"test\\\"\\s*:"
    },
    {
      "id": "lint-gate",
      "document": "docs/CLEAN_ARCHITECTURE_VERIFICATION.md",
      "pattern": "npm run lint:check",
      "evidenceFile": ".github/workflows/ci.yml",
      "evidencePattern": "npm run lint:check"
    },
    {
      "id": "coverage-gate",
      "document": "docs/CLEAN_ARCHITECTURE_VERIFICATION.md",
