{
  "name": "lingorise",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "seed:firestore": "ts-node -O \"{\\\"module\\\":\\\"commonjs\\\"}\" scripts/seedFirestore.ts",
    "test": "ts-node -O \"{\\\"module\\\":\\\"commonjs\\\"}\" tests/testSuite.ts",
    "test:a11y": "ts-node -O \"{\\\"module\\\":\\\"commonjs\\\"}\" tests/testSuite.ts",
    "test:rules": "firebase emulators:exec --only firestore \"ts-node -O \\\"{\\\\\\\"module\\\\\\\":\\\\\\\"commonjs\\\\\\\"}\\\" tests/firestoreRules.test.ts\"",
    "deploy:firestore": "firebase deploy --only firestore:rules,firestore:indexes",
    "test:e2e:smoke": "maestro test .maestro/smoke.yaml",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.20",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^56.0.20",
    "expo-asset": "~56.0.23",
    "expo-file-system": "~56.0.10",
    "expo-font": "~56.0.7",
    "expo-notifications": "~56.0.24",
    "expo-sharing": "~57.0.15",
    "expo-speech": "~56.0.3",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "firebase": "^12.18.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "firebase-tools": "^15.28.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  }
}
